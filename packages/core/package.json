{
  "name": "@agentcommit/core",
  "version": "0.1.0-alpha.1",
  "description": "Core transaction engine for AgentCommit: sessions, snapshots, CAS, diff, restore, and conflict detection.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "ignore": "^7.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/junchaojiang-sys/agentcommit.git"
  },
  "homepage": "https://github.com/junchaojiang-sys/agentcommit#readme",
  "bugs": {
    "url": "https://github.com/junchaojiang-sys/agentcommit/issues"
  },
  "keywords": [
    "ai-agent",
    "coding-agent",
    "rollback",
    "checkpoint",
    "workspace",
    "developer-tools"
  ]
